<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
              name="CertificatesReport" pageWidth="842" pageHeight="595" orientation="Landscape" columnWidth="802" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20">

    <parameter name="ReportTitle" class="java.lang.String"/>
    <parameter name="GeneratedBy" class="java.lang.String"/>
    <parameter name="GeneratedDate" class="java.lang.String"/>
    <parameter name="TotalCount" class="java.lang.Long"/>
    <parameter name="ActiveCount" class="java.lang.Long"/>
    <parameter name="RevokedCount" class="java.lang.Long"/>

    <field name="id" class="java.lang.Long"/>
    <field name="serialNumber" class="java.lang.String"/>
    <field name="subjectDN" class="java.lang.String"/>
    <field name="issuerDN" class="java.lang.String"/>
    <field name="status" class="java.lang.String"/>
    <field name="certificateType" class="java.lang.String"/>
    <field name="profileName" class="java.lang.String"/>
    <field name="notBefore" class="java.lang.String"/>
    <field name="notAfter" class="java.lang.String"/>

    <title>
        <band height="70">
            <staticText>
                <reportElement x="0" y="0" width="802" height="30"/>
                <textElement textAlignment="Left" verticalAlignment="Middle">
                    <font size="18" isBold="true"/>
                </textElement>
                <text><![CDATA[PKI Issuing CA - Certificate Inventory Report (Jasper Engine)]]></text>
            </staticText>
            <textField>
                <reportElement x="0" y="32" width="802" height="18"/>
                <textElement>
                    <font size="10" isItalic="true"/>
                </textElement>
                <textFieldExpression><![CDATA["Generated on: " + $P{GeneratedDate} + " | Operator: " + $P{GeneratedBy} + " | Total: " + $P{TotalCount} + " | Active: " + $P{ActiveCount} + " | Revoked: " + $P{RevokedCount}]]></textFieldExpression>
            </textField>
            <line>
                <reportElement x="0" y="55" width="802" height="1"/>
            </line>
        </band>
    </title>

    <columnHeader>
        <band height="25">
            <staticText>
                <reportElement mode="Opaque" backcolor="#212529" x="0" y="0" width="100" height="25" forecolor="#FFFFFF"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font size="9" isBold="true"/>
                </textElement>
                <text><![CDATA[Serial Number]]></text>
            </staticText>
            <staticText>
                <reportElement mode="Opaque" backcolor="#212529" x="100" y="0" width="180" height="25" forecolor="#FFFFFF"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font size="9" isBold="true"/>
                </textElement>
                <text><![CDATA[Subject DN]]></text>
            </staticText>
            <staticText>
                <reportElement mode="Opaque" backcolor="#212529" x="280" y="0" width="170" height="25" forecolor="#FFFFFF"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font size="9" isBold="true"/>
                </textElement>
                <text><![CDATA[Issuer DN]]></text>
            </staticText>
            <staticText>
                <reportElement mode="Opaque" backcolor="#212529" x="450" y="0" width="70" height="25" forecolor="#FFFFFF"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font size="9" isBold="true"/>
                </textElement>
                <text><![CDATA[Type]]></text>
            </staticText>
            <staticText>
                <reportElement mode="Opaque" backcolor="#212529" x="520" y="0" width="80" height="25" forecolor="#FFFFFF"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font size="9" isBold="true"/>
                </textElement>
                <text><![CDATA[Profile]]></text>
            </staticText>
            <staticText>
                <reportElement mode="Opaque" backcolor="#212529" x="600" y="0" width="60" height="25" forecolor="#FFFFFF"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font size="9" isBold="true"/>
                </textElement>
                <text><![CDATA[Status]]></text>
            </staticText>
            <staticText>
                <reportElement mode="Opaque" backcolor="#212529" x="660" y="0" width="70" height="25" forecolor="#FFFFFF"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font size="9" isBold="true"/>
                </textElement>
                <text><![CDATA[Valid From]]></text>
            </staticText>
            <staticText>
                <reportElement mode="Opaque" backcolor="#212529" x="730" y="0" width="72" height="25" forecolor="#FFFFFF"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font size="9" isBold="true"/>
                </textElement>
                <text><![CDATA[Valid To]]></text>
            </staticText>
        </band>
    </columnHeader>

    <detail>
        <band height="20">
            <textField isBlankWhenNull="true">
                <reportElement x="0" y="0" width="100" height="20"/>
                <box padding="2"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font size="8"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{serialNumber}]]></textFieldExpression>
            </textField>
            <textField isBlankWhenNull="true">
                <reportElement x="100" y="0" width="180" height="20"/>
                <box padding="2"/>
                <textElement verticalAlignment="Middle">
                    <font size="8"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{subjectDN}]]></textFieldExpression>
            </textField>
            <textField isBlankWhenNull="true">
                <reportElement x="280" y="0" width="170" height="20"/>
                <box padding="2"/>
                <textElement verticalAlignment="Middle">
                    <font size="8"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{issuerDN}]]></textFieldExpression>
            </textField>
            <textField isBlankWhenNull="true">
                <reportElement x="450" y="0" width="70" height="20"/>
                <box padding="2"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font size="8"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{certificateType}]]></textFieldExpression>
            </textField>
            <textField isBlankWhenNull="true">
                <reportElement x="520" y="0" width="80" height="20"/>
                <box padding="2"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font size="8"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{profileName}]]></textFieldExpression>
            </textField>
            <textField isBlankWhenNull="true">
                <reportElement x="600" y="0" width="60" height="20"/>
                <box padding="2"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font size="8" isBold="true"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{status}]]></textFieldExpression>
            </textField>
            <textField isBlankWhenNull="true">
                <reportElement x="660" y="0" width="70" height="20"/>
                <box padding="2"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font size="8"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{notBefore}]]></textFieldExpression>
            </textField>
            <textField isBlankWhenNull="true">
                <reportElement x="730" y="0" width="72" height="20"/>
                <box padding="2"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font size="8"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{notAfter}]]></textFieldExpression>
            </textField>
        </band>
    </detail>

    <pageFooter>
        <band height="20">
            <textField>
                <reportElement x="0" y="0" width="802" height="20"/>
                <textElement textAlignment="Right" verticalAlignment="Middle">
                    <font size="8"/>
                </textElement>
                <textFieldExpression><![CDATA["Page " + $V{PAGE_NUMBER}]]></textFieldExpression>
            </textField>
        </band>
    </pageFooter>
</jasperReport>
