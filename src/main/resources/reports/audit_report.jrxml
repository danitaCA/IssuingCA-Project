<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
              name="AuditReport" pageWidth="842" pageHeight="595" orientation="Landscape" columnWidth="802" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20">

    <parameter name="ReportTitle" class="java.lang.String"/>
    <parameter name="GeneratedBy" class="java.lang.String"/>
    <parameter name="GeneratedDate" class="java.lang.String"/>
    <parameter name="ChainStatus" class="java.lang.String"/>
    <parameter name="TotalRecords" class="java.lang.Integer"/>

    <field name="id" class="java.lang.Long"/>
    <field name="timestamp" class="java.lang.String"/>
    <field name="username" class="java.lang.String"/>
    <field name="action" class="java.lang.String"/>
    <field name="status" class="java.lang.String"/>
    <field name="ipAddress" class="java.lang.String"/>
    <field name="checksum" class="java.lang.String"/>

    <title>
        <band height="70">
            <staticText>
                <reportElement x="0" y="0" width="802" height="30"/>
                <textElement textAlignment="Left" verticalAlignment="Middle">
                    <font size="18" isBold="true"/>
                </textElement>
                <text><![CDATA[PKI Audit Trail & Cryptographic Verification Report (Jasper Engine)]]></text>
            </staticText>
            <textField>
                <reportElement x="0" y="32" width="802" height="18"/>
                <textElement>
                    <font size="10" isItalic="true"/>
                </textElement>
                <textFieldExpression><![CDATA["Generated: " + $P{GeneratedDate} + " | Operator: " + $P{GeneratedBy} + " | Integrity: " + $P{ChainStatus} + " | Total Records: " + $P{TotalRecords}]]></textFieldExpression>
            </textField>
            <line>
                <reportElement x="0" y="55" width="802" height="1"/>
            </line>
        </band>
    </title>

    <columnHeader>
        <band height="25">
            <staticText>
                <reportElement mode="Opaque" backcolor="#212529" x="0" y="0" width="50" height="25" forecolor="#FFFFFF"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font size="9" isBold="true"/>
                </textElement>
                <text><![CDATA[ID]]></text>
            </staticText>
            <staticText>
                <reportElement mode="Opaque" backcolor="#212529" x="50" y="0" width="130" height="25" forecolor="#FFFFFF"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font size="9" isBold="true"/>
                </textElement>
                <text><![CDATA[Timestamp]]></text>
            </staticText>
            <staticText>
                <reportElement mode="Opaque" backcolor="#212529" x="180" y="0" width="100" height="25" forecolor="#FFFFFF"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font size="9" isBold="true"/>
                </textElement>
                <text><![CDATA[User]]></text>
            </staticText>
            <staticText>
                <reportElement mode="Opaque" backcolor="#212529" x="280" y="0" width="140" height="25" forecolor="#FFFFFF"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font size="9" isBold="true"/>
                </textElement>
                <text><![CDATA[Action]]></text>
            </staticText>
            <staticText>
                <reportElement mode="Opaque" backcolor="#212529" x="420" y="0" width="70" height="25" forecolor="#FFFFFF"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font size="9" isBold="true"/>
                </textElement>
                <text><![CDATA[Status]]></text>
            </staticText>
            <staticText>
                <reportElement mode="Opaque" backcolor="#212529" x="490" y="0" width="90" height="25" forecolor="#FFFFFF"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font size="9" isBold="true"/>
                </textElement>
                <text><![CDATA[IP Address]]></text>
            </staticText>
            <staticText>
                <reportElement mode="Opaque" backcolor="#212529" x="580" y="0" width="222" height="25" forecolor="#FFFFFF"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font size="9" isBold="true"/>
                </textElement>
                <text><![CDATA[Chained Checksum (SHA-256)]]></text>
            </staticText>
        </band>
    </columnHeader>

    <detail>
        <band height="20">
            <textField isBlankWhenNull="true">
                <reportElement x="0" y="0" width="50" height="20"/>
                <box padding="2"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font size="8"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{id}]]></textFieldExpression>
            </textField>
            <textField isBlankWhenNull="true">
                <reportElement x="50" y="0" width="130" height="20"/>
                <box padding="2"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font size="8"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{timestamp}]]></textFieldExpression>
            </textField>
            <textField isBlankWhenNull="true">
                <reportElement x="180" y="0" width="100" height="20"/>
                <box padding="2"/>
                <textElement verticalAlignment="Middle">
                    <font size="8"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{username}]]></textFieldExpression>
            </textField>
            <textField isBlankWhenNull="true">
                <reportElement x="280" y="0" width="140" height="20"/>
                <box padding="2"/>
                <textElement verticalAlignment="Middle">
                    <font size="8"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{action}]]></textFieldExpression>
            </textField>
            <textField isBlankWhenNull="true">
                <reportElement x="420" y="0" width="70" height="20"/>
                <box padding="2"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font size="8" isBold="true"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{status}]]></textFieldExpression>
            </textField>
            <textField isBlankWhenNull="true">
                <reportElement x="490" y="0" width="90" height="20"/>
                <box padding="2"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font size="8"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{ipAddress}]]></textFieldExpression>
            </textField>
            <textField isBlankWhenNull="true">
                <reportElement x="580" y="0" width="222" height="20"/>
                <box padding="2"/>
                <textElement verticalAlignment="Middle">
                    <font size="7"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{checksum}]]></textFieldExpression>
            </textField>
        </band>
    </detail>

    <pageFooter>
        <band height="20">
            <textField>
                <reportElement x="0" y="0" width="802" height="20"/>
                <textElement textAlignment="Right" verticalAlignment="Middle">
                    <font size="8"/>
                </textElement>
                <textFieldExpression><![CDATA["Page " + $V{PAGE_NUMBER}]]></textFieldExpression>
            </textField>
        </band>
    </pageFooter>
</jasperReport>
